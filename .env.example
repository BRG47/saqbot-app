# Copy to .env.local for local development. Never commit real values.

# ---- Public (shipped to the browser) ----
# Keep "true" until everything is tested on Hyperliquid testnet.
NEXT_PUBLIC_HL_TESTNET=true
# From the Privy dashboard (privy.io): App settings > App ID
NEXT_PUBLIC_PRIVY_APP_ID=
# Your builder wallet's PUBLIC address. Needs 100+ USDC in its Hyperliquid perps account.
NEXT_PUBLIC_BUILDER_ADDRESS=
# BAWSAQ holder discount (Robinhood Chain)
NEXT_PUBLIC_BAWSAQ_TOKEN=0x756A626544D90585fF9E5E6edEF5406a69b45C9c
NEXT_PUBLIC_BAWSAQ_MIN_HOLD=1000000
# Use a provider RPC in production; the public one is rate limited.
NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=TradeSaqBot
# From `npm run vapid`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ---- Server only (web app API routes and the worker) ----
DATABASE_URL=postgres://user:pass@host:5432/saqbot
# Privy dashboard > App settings > Verification key (paste the PEM; \n line breaks are fine)
PRIVY_VERIFICATION_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bawsaqonrh@gmail.com
TELEGRAM_BOT_TOKEN=
APP_URL=https://saqbot.xyz
# Long random string; protects /api/admin/events
ADMIN_TOKEN=

# ---- Security headers ----
# "report" (default) only logs Content Security Policy violations to /api/csp-report.
# Switch to "enforce" once the logs are clean after testing every flow.
CSP_MODE=report
# Optional: your Privy custom auth domain after setting up HttpOnly cookies, e.g. https://privy.saqbot.xyz
PRIVY_AUTH_DOMAIN=
